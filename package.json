{
  "name": "tree-sitter-fidl",
  "version": "1.0.0",
  "description": "tree-sitter parser for fidl",
  "repository": "https://github.com/google/tree-sitter-fidl",
  "license": "Apache-2.0",
  "author": {
    "name": "chaopeng",
    "email": "chaopeng@google.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "fidl"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "tree-sitter generate",
    "fmt": "oxfmt grammar.js bindings/node",
    "lint": "oxfmt --check grammar.js bindings/node && oxlint --deny-warnings grammar.js bindings/node",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test"
  }
}
